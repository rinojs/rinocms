{
  "name": "rino-cms",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "client:dev": "node ./src/client/dev.js",
    "client:generate": "node ./src/client/generate.js",
    "client:generate-all": "node generate.js && node sitemap.js && node feed.js",
    "client:generate-sitemap": "node generate.js && node sitemap.js",
    "client:feed": "node feed.js",
    "client:sitemap": "node sitemap.js",
    "client:dev-full": "nodemon --config nodemon.client.json",
    "server": "node ./src/server/app.js",
    "server:dev": "nodemon --config nodemon.server.json",
    "backoffice:dev": "node ./src/backoffice/dev.js",
    "backoffice:dev-full": "nodemon --config nodemon.backoffice.json",
    "dev:full": "concurrently \"npm run client:dev-full\" \"npm run server:dev\" \"npm run backoffice:dev-full\"",
    "dev": "concurrently \"npm run client:dev-full\" \"npm run server:dev\""
  },
  "dependencies": {
    "@inquirer/prompts": "^8.2.0",
    "@toast-ui/editor": "^3.1.0",
    "@toast-ui/editor-plugin-chart": "^3.0.1",
    "@toast-ui/editor-plugin-code-syntax-highlight": "^3.1.0",
    "@toast-ui/editor-plugin-color-syntax": "^3.1.0",
    "@toast-ui/editor-plugin-table-merged-cell": "^3.1.0",
    "@toast-ui/editor-plugin-uml": "^3.0.1",
    "bcrypt": "^6.0.0",
    "chalk": "^5.6.2",
    "crumbdb": "^0.7.0",
    "express": "^5.2.1",
    "nodemon": "^3.1.11",
    "rinojs": "^2.19.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "typescript": "^5.8.2"
  }
}
